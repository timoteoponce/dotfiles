# Copy to /etc/nixos/local.nix on a machine that needs these.
# That path is not in git. This Inspiron uses the copy already installed there.
{ pkgs, ... }:
{
  # The QCA9377 drops the link when Wi-Fi power saving is on.
  networking.networkmanager.wifi.powersave = false;

  # VA-API for the Ice Lake Iris Plus GPU.
  hardware.graphics.extraPackages = [ pkgs.intel-media-driver ];

  services.thermald.enable = true;
}
