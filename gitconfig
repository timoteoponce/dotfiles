[alias]
  ci = commit
  co = checkout
  df = diff
  br = branch
  st =  status -s -b
  stat = status -s -b
  checkout = co
  lg = log -n 10 --graph --pretty=format:'%Cred%h%Creset%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
  ls = ls-files --modified
  changes = ls-files --modified
  extra = ls-files --others
  cached = ls-files --cached
  staged = ls-files --stage
  missing = ls-files --deleted
  prune= "git remote prune origin && git fetch -p"
  gone = "!f() { git fetch --all --prune; git branch -vv | awk '/: gone]/{print $1}' | xargs git branch -D; }; f"

[color]
  ui = auto
  diff = auto
  status = auto
  branch = auto

[core]
  pager = less -FXRS
  ; pager = delta
  editor = nvim
	excludesFile = ~/.gitignore
  autocrlf = input
	quotepath = false

[user]
  name = Timoteo Ponce
[pull]
  rebase = false
[init]
	defaultBranch = main
[mergetool]
  prompt = true
	keepBackup = false

[merge]
  tool = nvim-merge

[mergetool "nvim-merge"]
  cmd = nvim -d $LOCAL $MERGED $REMOTE -c '$wincmd w' -c 'wincmd J'
  trustExitCode = true

[difftool]
  prompt = true

[difftool "nvimdiff"]
  cmd = nvim -d $LOCAL $REMOTE
[fetch]
	prune = true
	pruneTags = true
	all = true
[diff]
	tool = nvimdiff
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[push]
	autoSetupRemote = true
	default = simple
	followTags = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[help]
	autocorrect = prompt


[credential "https://github.com"]
	helper = 
	helper = !which gh >/dev/null 2>&1 && exec gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !which gh >/dev/null 2>&1 && exec gh auth git-credential

