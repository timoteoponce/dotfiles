[user]
  name = Timoteo Ponce
  # email is set per-machine in ~/.gitconfig.local (kept out of the public repo)

# Machine-specific / work config: user.email, credential managers, corp hosts, …
# Created by install.sh if missing; never linked from the repo.
[include]
  path = ~/.gitconfig.local

[includeIf "gitdir:~/projects/confinale/"]
  path = ~/projects/confinale/.gitconfig

[alias]
  ci = commit
  co = checkout
  df = diff
  br = branch
  st = status -s -b
  stat = status -s -b
  lg = log -n 20 --graph --pretty=format:'%Cred%h%Creset%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
  ls = ls-files --modified
  changes = ls-files --modified
  extra = ls-files --others
  cached = ls-files --cached
  staged = ls-files --stage
  missing = ls-files --deleted
  undo = reset --soft HEAD~1
  prune = "!git remote prune origin && git fetch -p"
  gone = "!f() { git fetch --all --prune; git branch -vv | awk '/: gone]/{print $1}' | xargs -r git branch -D; }; f"

[core]
	# pager = cat
  pager = less -FXRS
  editor = nvim
  excludesFile = ~/.gitignore
  autocrlf = input
  quotepath = false
[color]
  ui = auto

[diff]
  algorithm = histogram
  colorMoved = default
  mnemonicPrefix = true
  renames = true

[merge]
  tool = nvim-merge
  conflictstyle = zdiff3

[mergetool]
  prompt = true
  keepBackup = false

[mergetool "nvim-merge"]
  cmd = nvim -d $LOCAL $MERGED $REMOTE -c '$wincmd w' -c 'wincmd J'
  trustExitCode = true

[difftool]
  prompt = true

[rerere]
  enabled = true

[rebase]
  autosquash = true
  autostash = true

[pull]
  rebase = false

[push]
  autoSetupRemote = true
	default = current
  followTags = true

[fetch]
  prune = true
  pruneTags = true
  all = true

[init]
  defaultBranch = main

[branch]
  sort = -committerdate

[tag]
  sort = version:refname

[column]
  ui = auto

[help]
  autocorrect = prompt

[credential "https://github.com"]
  helper =
  helper = !gh auth git-credential
[credential "https://gist.github.com"]
  helper =
  helper = !gh auth git-credential
